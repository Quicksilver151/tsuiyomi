# Copy to .env.local and adjust. Never commit .env.local.
#
# Library root containing one directory per series.
TSUIYOMI_LIBRARY="${XDG_DATA_HOME:-$HOME/.local/share}/tsuiyomi/local"

# Log level: error | warn | info | debug | trace
TSUIYOMI_LOG="info"

# Extension host. Unset to start the bundled runtime.
# TSUIYOMI_HOST_URL="http://127.0.0.1:4567"
# TSUIYOMI_HOST_JAR="/path/to/miwayomi.jar"
# TSUIYOMI_JAVA="/path/to/jre/bin/java"
