+package eu.kanade.tachiyomi
+
+/**
+ * Host identity used by extensions built against extension-lib 1.3+.
+ *
+ * Mihon ships this in the app module; headless hosts have to provide it themselves.
+ */
+object AppInfo {
+    fun getVersionCode(): Int = 102
+
+    fun getVersionName(): String = "1.0.2"
+
+    fun getSupportedImageMimeTypes(): List<String> =
+        listOf("image/jpeg", "image/png", "image/webp", "image/gif", "image/avif")
+}
