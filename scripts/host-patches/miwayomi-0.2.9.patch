+package miwayomi.api
+
+import io.ktor.http.HttpStatusCode
+import io.ktor.server.application.Application
+import io.ktor.server.application.call
+import io.ktor.server.request.receive
+import io.ktor.server.response.respond
+import io.ktor.server.routing.get
+import io.ktor.server.routing.post
+import io.ktor.server.routing.routing
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.encodeToString
+import kotlinx.serialization.json.Json
+import miwayomi.di.ConfigHolder
+import java.io.File
+import java.util.concurrent.ConcurrentHashMap
+
+/**
+ * Read-state/bookmark mirror for remote chapters. Mihon keeps this in its database;
+ * miwayomi stores a small JSON file in the host data directory so a client restart
+ * does not lose progress. Keys are `sourceId\nmangaUrl\nchapterUrl`.
+ */
+@Serializable
+data class ReadStateDto(
+    val sourceId: String,
+    val mangaUrl: String,
+    val chapterUrl: String,
+    val page: Int = 0,
+    val pages: Int = 0,
+    val read: Boolean = false,
+    val bookmark: Boolean = false,
+)
+
+@Serializable
+data class ReadStatesDto(val chapters: List<ReadStateDto> = emptyList())
+
+@Serializable
+data class ReadStateBatchDto(
+    val chapters: List<ReadStateDto> = emptyList(),
+    val clear: List<String> = emptyList(),
+)
+
+@Serializable
+data class StateResultDto(val ok: Boolean, val error: String? = null)
+
+fun Application.registerStateApi() {
+    val file = File(ConfigHolder.config.dataDir, "read_state.json")
+    val json = Json { ignoreUnknownKeys = true; prettyPrint = true }
+    val states = ConcurrentHashMap<String, ReadStateDto>()
+
+    fun key(state: ReadStateDto): String = "${state.sourceId}\n${state.mangaUrl}\n${state.chapterUrl}"
+
+    if (file.exists()) {
+        runCatching {
+            json.decodeFromString<ReadStatesDto>(file.readText()).chapters.forEach {
+                states[key(it)] = it
+            }
+        }.onFailure { println("[miwayomi] could not read read_state.json: $it") }
+    }
+
+    fun save() {
+        synchronized(states) {
+            val temp = File(file.parentFile, file.name + ".tmp")
+            temp.writeText(json.encodeToString(ReadStatesDto(states.values.toList())))
+            if (!temp.renameTo(file)) {
+                file.writeText(temp.readText())
+                temp.delete()
+            }
+        }
+    }
+
+    routing {
+        get("/api/v1/state") {
+            call.respond(ReadStatesDto(states.values.sortedWith(compareBy({ it.sourceId }, { it.mangaUrl }, { it.chapterUrl }))))
+        }
+
+        post("/api/v1/state/chapters") {
+            val req = runCatching { call.receive<ReadStateBatchDto>() }.getOrNull()
+                ?: return@post call.respond(HttpStatusCode.BadRequest, StateResultDto(false, "invalid body"))
+            req.clear.forEach { states.remove(it) }
+            req.chapters.forEach { states[key(it)] = it }
+            save()
+            call.respond(StateResultDto(true))
+        }
+    }
+}
