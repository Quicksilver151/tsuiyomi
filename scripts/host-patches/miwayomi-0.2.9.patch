+)
+
+@Serializable
+data class CookieClearDto(
+    val ok: Boolean,
+    val cleared: Int = 0,
+    val error: String? = null,
+)
+
+private class HeaderFilter(name: String) : Filter.Header(name)
+private class SeparatorFilter(name: String) : Filter.Separator(name)
+private class CheckBoxFilter(name: String, state: Boolean) : Filter.CheckBox(name, state)
+private class TriStateFilter(name: String, state: Int) : Filter.TriState(name, state)
+private class TextFilter(name: String, state: String) : Filter.Text(name, state)
+private class SelectFilter(name: String, values: Array<String>, state: Int) :
+    Filter.Select<String>(name, values, state)
+private class SortFilter(name: String, values: Array<String>, state: Filter.Sort.Selection?) :
+    Filter.Sort(name, values, state)
+private class GroupFilter(name: String, state: List<Filter<*>>) :
+    Filter.Group<Filter<*>>(name, state)
+
+private fun Filter<*>.toFilterDto(): FilterDto = when (this) {
+    is Filter.Header -> FilterDto(type = "header", name = name)
+    is Filter.Separator -> FilterDto(type = "separator", name = name)
+    is Filter.CheckBox -> FilterDto(type = "checkbox", name = name, checked = state)
+    is Filter.TriState -> FilterDto(type = "tristate", name = name, triState = state)
+    is Filter.Text -> FilterDto(type = "text", name = name, text = state)
+    is Filter.Select<*> -> FilterDto(
+        type = "select",
+        name = name,
+        selected = state,
+        values = values.map { it.toString() },
+    )
+    is Filter.Sort -> FilterDto(
+        type = "sort",
+        name = name,
+        sortIndex = state?.index,
+        ascending = state?.ascending,
+        values = values.map { it.toString() },
+    )
+    is Filter.Group<*> -> FilterDto(
+        type = "group",
+        name = name,
+        children = state.filterIsInstance<Filter<*>>().map { it.toFilterDto() },
+    )
+    else -> FilterDto(type = "unknown", name = name)
+}
+
+private fun FilterDto.toFilter(): Filter<*>? = when (type) {
+    "header" -> HeaderFilter(name)
+    "separator" -> SeparatorFilter(name)
+    "checkbox" -> CheckBoxFilter(name, checked ?: false)
+    "tristate" -> TriStateFilter(name, triState ?: 0)
+    "text" -> TextFilter(name, text.orEmpty())
+    "select" -> SelectFilter(name, values.orEmpty().toTypedArray(), selected ?: 0)
+    "sort" -> SortFilter(
+        name,
+        values.orEmpty().toTypedArray(),
+        sortIndex?.let { Filter.Sort.Selection(it, ascending ?: true) },
+    )
+    "group" -> GroupFilter(
+        name,
+        children.orEmpty().mapNotNull { it.toFilter() },
+    )
+    else -> null
+}
+
+fun Application.registerFilterApi() {
+    val mangaSources = Injekt.get<MangaSourceManager>()
+
+    routing {
+        get("/api/v1/manga/{sourceId}/filters") {
+            val source = call.sourceId().manga(mangaSources) ?: return@get call.respondNotFound()
+            val dto = try {
+                FilterListDto(filters = source.getFilterList().map { it.toFilterDto() })
+            } catch (e: Throwable) {
+                println("[miwayomi] getFilterList() failed for ${source.name}: $e")
+                FilterListDto(error = e.message ?: "could not load filters")
+            }
+            call.respond(dto)
+        }
+
+        post("/api/v1/manga/{sourceId}/search") {
+            val source = call.sourceId().manga(mangaSources) ?: return@post call.respondNotFound()
+            val request = call.receive<FilterSearchRequest>()
+            val filters = FilterList(request.filters.mapNotNull { it.toFilter() })
+            val res = source.getSearchManga(request.page.coerceAtLeast(1), request.query, filters)
+            call.respond(MangasPageDto(res.hasNextPage, res.mangas.map { it.toDto() }))
+        }
+
+        post("/api/v1/sources/{sourceId}/cookies/clear") {
+            val source = call.sourceId().manga(mangaSources) as? HttpSource
+                ?: return@post call.respond(
+                    HttpStatusCode.BadRequest,
+                    CookieClearDto(ok = false, error = "source does not support cookies"),
+                )
+            val network = Injekt.get<NetworkHelper>()
+            val jar = network.cookieJar as? JvmCookieJar
+                ?: return@post call.respond(
+                    HttpStatusCode.BadRequest,
+                    CookieClearDto(ok = false, error = "cookie store does not support clearing"),
+                )
+            val urls = listOf(source.baseUrl)
+                .filter { it.isNotEmpty() }
+                .distinct()
+            val cleared = urls.sumOf { url ->
+                runCatching { jar.remove(url.toHttpUrl()) }.getOrDefault(0)
+            }
+            call.respond(CookieClearDto(ok = true, cleared = cleared))
+        }
+    }
+}
